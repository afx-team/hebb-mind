# Hebb Mind examples — environment template
# Copy this file to `.env` (in the same directory) and fill in at least one
# LLM provider key if you want example 02 to call a real model.

# ---- LLM providers (used by examples/02_persistent_chat.py via LiteLLM) ----
OPENAI_API_KEY=
# OR any other LiteLLM-supported provider, see https://docs.litellm.ai/docs/providers
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=
# OLLAMA_API_BASE=http://localhost:11434

# ---- Hebb Mind storage ----
# Where the example SQLite database lives. Safe to delete to start fresh.
HEBB_DB_PATH=./examples/data/example.db
