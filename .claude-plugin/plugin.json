{
  "name": "hebb-mind",
  "version": "0.1.7",
  "description": "Neuroscience-inspired long-term memory for Claude Code — auto-captures and recalls cross-session context",
  "author": "afx-team",
  "homepage": "https://github.com/afx-team/hebb-mind",
  "mcpServers": {
    "hebb": {
      "type": "stdio",
      "command": "hebb-mcp"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "hebb cc recall",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "hebb cc write",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "hebb cc stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
