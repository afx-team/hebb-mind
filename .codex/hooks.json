{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "hebb codex recall",
            "timeout": 30,
            "statusMessage": "Recalling Hebb Mind context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hebb codex prompt",
            "timeout": 10,
            "statusMessage": "Searching Hebb Mind"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "hebb codex stop",
            "timeout": 30,
            "statusMessage": "Saving turn to Hebb Mind"
          }
        ]
      }
    ]
  }
}
